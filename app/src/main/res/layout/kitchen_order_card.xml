<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp"
    android:layout_margin="8dp"
    android:background="#FFF9C4"
    android:elevation="4dp">
    <TextView
        android:id="@+id/ticketOrderId"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#000000"
        android:text="Order #123"/>

    <TextView
        android:id="@+id/ticketTableNumber"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="18sp"
        android:textColor="#1565C0"
        android:textStyle="bold"
        android:layout_marginTop="4dp"
        android:text="Table: ?"/>

    <TextView
        android:id="@+id/ticketItemId"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="18sp"
        android:textColor="#333333"
        android:layout_marginTop="8dp"
        android:text="Item ID: 5"/>

    <TextView
        android:id="@+id/ticketStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="16sp"
        android:textColor="#E65100"
        android:textStyle="italic"
        android:layout_marginTop="4dp"
        android:text="Status: Pending"/>

    <Button
        android:id="@+id/markReadyBtn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Mark as Ready"
        android:backgroundTint="#4CAF50"
        android:textColor="#FFFFFF"/>

</LinearLayout>